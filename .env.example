# ───────────── Core ─────────────
# Local dev uses SQLite. For production use PostgreSQL (Neon / Supabase / Railway) and
# change `provider` in prisma/schema.prisma to "postgresql".
DATABASE_URL="file:./dev.db"

# Public URL of the site (used in emails and payment callbacks)
APP_URL="http://localhost:3000"

# Long random string (min 32 chars). Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET="change-me-to-a-long-random-secret-at-least-32-characters"

# Max devices a student can be logged in on at the same time (anti account-sharing)
MAX_ACTIVE_SESSIONS=2

# ───────────── Payments: Razorpay ─────────────
# Leave blank to run in DEMO mode (simulated checkout, no money moves).
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Set in Razorpay Dashboard → Webhooks (event: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=""

# ───────────── Video hosting ─────────────
# demo     → streams local files from /storage/videos via signed, short-lived URLs (dev/demo only)
# vdocipher→ Hollywood-grade DRM (Widevine/FairPlay) + dynamic watermark. Recommended for launch.
# bunny    → Bunny Stream with token-authenticated embeds (cheaper; enable MediaCage DRM in Bunny)
VIDEO_PROVIDER="demo"
VDOCIPHER_API_SECRET=""
BUNNY_LIBRARY_ID=""
BUNNY_TOKEN_KEY=""

# ───────────── Email (optional) ─────────────
# Your GoDaddy / Microsoft 365 mailbox, e.g. smtp.office365.com:587 or smtpout.secureserver.net:465
# Leave blank in dev: emails are printed to the server console instead.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER="info@bulls2bear.com"
SMTP_PASS=""
MAIL_FROM="bulls2bear <info@bulls2bear.com>"
CONTACT_EMAIL="info@bulls2bear.com"

# ───────────── Admin bootstrap ─────────────
# The seed script creates this admin account (change the password after first login!)
ADMIN_EMAIL="admin@bulls2bear.com"
ADMIN_PASSWORD="ChangeMe@12345"
